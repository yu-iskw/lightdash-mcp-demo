# Lightdash MCP demo — copy to .env.local and fill in values

LIGHTDASH_URL=https://app.lightdash.cloud
LIGHTDASH_OAUTH_CLIENT_ID=oauth-xxxxxxxxxxxxxxxx
LIGHTDASH_OAUTH_CLIENT_SECRET=your-secret-here
MCP_SERVER_PORT=3100

# Required for OAuth protected-resource metadata (Phase 3+ / ngrok)
MCP_PUBLIC_URL=https://your-subdomain.ngrok-free.app

# Manual testing only (Phase 2 curl script)
# LIGHTDASH_ACCESS_TOKEN=ldapp_...
